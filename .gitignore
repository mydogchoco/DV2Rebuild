# ── 공개 레포에는 **게임 실행에 필요한 것만** 올린다 ──────────
# 올라가는 것: project.godot · 게임 코드(scripts/) · 씬(scenes/) · 마스터 데이터(data/) ·
#              에셋 변환 파이프라인(화이트리스트) · icon.svg
# 레퍼런스·설계 문서·분석 자료는 전부 로컬 전용이다(저작권 + 레포 정리).
/docs/
*.md
# README 만 예외 — 공개 레포의 안내문.
!/README.md
# 원작 APK 의 안드로이드 리소스(res/anim 등 1,570개) — 코드에서 참조하지 않는다.
/res/
# 미참조 잔여 이미지·기획 메모
/Worldmapimage.png
/Worldmapimage.png.import
/image.png
/image.png.import
/*.txt

# 검수용 몽타주(QA 산출물) — 원본이 아니라 아이콘을 격자로 붙인 그림이고, 코드가 참조하지
# 않는다. monster_sheets · skills_sheet 와 같은 정책: 그림은 빼고 만드는 도구만 추적한다.
#   재생성: godot --path . --script res://scripts/tools/montage.gd -- <out.png> <scene...>
/equip_icon_montage.png
/equip_icon_montage.png.import
/soul_gem_montage.png
/soul_gem_montage.png.import
# 원작 캡처 영상(저작권) — old_screenshots 와 같은 정책. 로컬 대조용으로만 둔다.
/*.mp4
# 세션 중 만든 일회성 분석 덤프·리다이렉션 사고 파일. 코드가 읽지 않는다.
/.item_hits.json
/.item_src.json
/1
# `_tmp_` 접두사 = 스스로 "검수 끝나면 지운다"고 적어 둔 일회용 검수 창.
/scenes/_tmp_*
/scripts/tools/_tmp_*

# Godot import cache / exports
.godot/
/export/
/build/
*.tmp
*.translation

# Local saves (gitignored per CLAUDE.md)
/saves/

# Raw assets — live in their own repo (DV2/, ~579MB). Not committed here.
# 폴더 자리만 .gitkeep 으로 올려 둔다 — 클론한 뒤 여기에 원본 에셋을 넣으면 된다.
/DV2/*
!/DV2/.gitkeep
# `.gdignore`(0바이트 마커) 는 **반드시 함께 올린다.** 이게 없으면 클론본에 원본 에셋을 넣는
# 순간 Godot 이 DV2/ 트리 전체(아틀라스·plist·ccz 수만 개)를 임포트하려 든다.
!/DV2/.gdignore
# 예외: DV2/ORIGINAL/ 는 원작 아틀라스 덤프가 아니라 **외부 반입 원본**이다(🟦 사용자 확정 2026-08-07).
#   WildSP/  = 선대군 원화(오리지널 캐릭터, 자작)  → build_sundaegun_npc.py 의 유일한 원본
#   Loki/    = 도감 800 로키 스켈레톤·아이콘·이펙트 → build_loki800.py 의 유일한 원본
# 둘 다 다른 곳에서 재생성할 수 없고, 없으면 그 두 빌더가 못 돈다 → 레포에 함께 올린다.
!/DV2/ORIGINAL/
# 단 **그림은 원작 유래분을 올리지 않는다.** Loki 그림·UIbar 는 로컬 전용이고,
# 좌표 메타데이터는 자체 포맷(*.src.json)으로 변환해 올린다. WildSP(자작 원화)만 그대로.
/DV2/ORIGINAL/**/*.pvr.ccz
/DV2/ORIGINAL/Loki/**/*.png
/DV2/ORIGINAL/UIbar.png
/DV2/ORIGINAL/Loki/**/*.atlas
/DV2/ORIGINAL/Loki/**/*.plist
/DV2/ORIGINAL/Loki/**/*.json
!/DV2/ORIGINAL/Loki/**/*.src.json

# 원작 UI 비트맵 폰트(.fnt/.png) — 원작 자산이므로 공개 레포에 두지 않는다(사용자 확정 2026-07-30).
# 로컬에는 그대로 있고 build_fonts.py 가 이것을 원본으로 삼는다. 클론본은 원작 에셋과 함께 준비해야 한다.
/assets/480/

# Converted assets can be regenerated by scripts/tools — keep out of git
/assets/converted/*
!/assets/converted/.gitkeep

# Large wiki reference PDFs (hundreds of MB)

# 원작 음악(저작권) — BGM 시스템이 로컬에서 사용, 공개 레포 비게시
/assets/music/
# 원작 게임 스크린샷(저작권) — 공개 레포 비게시. 로컬 설계 참고용으로만 유지(CLAUDE.md §1)
# 스킬 아이콘 시트(저작권 파생 몽타주) + godot csv import 메타 — 로컬 전용
/docs/input/skills/skills_sheet.png
/docs/input/skills/skills_sheet.png.import
/docs/input/skills/skills_skeleton.csv.import

# 카드 코드 **평문** 원본 — 이 레포는 공개다. 코드/보상 목록이 올라가면 암호화가 무의미해진다.
# 커밋되는 것은 build_card_codes.py 산출물(data/card_codes.json = 코드로만 풀리는 암호문)뿐이다.
/docs/input/sheets/card_codes.csv

# 아이템 아이콘 시트(같은 이유). CSV·README 는 추적하고 그림만 뺀다 — build_item_sheet.py 로 재생성.
/docs/input/items/*.png
/docs/input/items/*.png.import
/docs/input/items/*.csv.import

# 원작 바이너리·분석 자료(저작권) — 로컬 전용.
# ⚠️ gitignore 는 줄 끝 주석을 지원하지 않는다 — 패턴 줄에 주석을 붙이지 말 것.
*.so
Dragon+Village+2.apk
Dragon+Village+2.xapk

# Python
__pycache__/
*.pyc

# Windows 탐색기 폴더 메타데이터
desktop.ini
Thumbs.db

# Claude Code local harness settings
/.claude/

# Generated artifacts (regenerable by scripts/tools)
/scenes/dragons/
/scratch_shots/
/image.png

# 저작권: 알 개봉 spine 파생(scene/laboratory/egg) — dragon/monster spine과 동일 정책
scenes/eggs/

# 저작권: 진화 이펙트 spine 파생(scene/mamorudiclab)
scenes/fx/

# 몬스터 식별 시트 — 원본 아트를 조립해 만든 그림이라 공개 원격에 올리지 않는다.
# 문서(docs/input/review/monster_sheet.md)만 추적하고, 그림은 shot_monsters.gd 로 재생성한다.
/docs/input/review/monster_sheets/

# 저작권: 레벨업 연출 참고 영상 프레임(원작 캡처) — old_screenshots 와 동일 정책
# 저작권: 던전 팝업 레퍼런스(2016 방송 캡처) — uno 와 동일 정책

# 🟦 관리자 모드 로컬 표식(사용자 요청 2026-08-09). 있으면 `UserDB.is_admin()` 이 켜진다.
# 레포 기본값은 `UserDB.ADMIN = false` 그대로 두고, 이 파일로 **내 컴퓨터에서만** 켠다.
# 공개 레포를 클론한 사람은 이 파일이 없으니 원작 구성(선대군 NPC · 연승방지봇)으로 시작한다.
/admin.local

# 로컬 전용 도구(공개 제외) — 게이트/스크럽 스크립트
/scripts/tools/local/

# ── 파이썬 도구는 기본 비공개, **에셋 변환 파이프라인만 공개** ──────────────
# 공개 기준: "클론 + DV2/ 에 원작 에셋 반입 → 변환 산출물(assets/converted, 생성 씬,
# 음악 반입)을 재생성해 게임이 뜬다"에 필요한 체인. 데이터 생성·분석 도구는 로컬 전용
# (data/*.json 은 이미 커밋돼 있어 클론본에 불필요).
# ⚠️ 원작 패키지를 직접 여는 도구는 공개하지 않는다
# (ccz_to_png · fix_atlas_plist · build_intro_assets). 배포 전제는 **암호화되지 않은
# 에셋 폴더**를 DV2/ 에 넣는 것이라, 클론본에 이 도구들이 필요하지 않다.
/scripts/tools/*.py
!/scripts/tools/atlas.py
!/scripts/tools/cocos_export.py
!/scripts/tools/spine_export.py
!/scripts/tools/spine_batch.py
!/scripts/tools/particle_export.py
