!/scripts/tools/build_battle_fx.py
!/scripts/tools/build_cave_fx.py
!/scripts/tools/build_colosseum_fx.py
!/scripts/tools/build_facility_bg.py
!/scripts/tools/build_npc.py
!/scripts/tools/build_shop_bg.py
!/scripts/tools/build_skill_fx.py
!/scripts/tools/build_town_sky.py
!/scripts/tools/build_ui_bar.py
!/scripts/tools/build_ultimate_fx.py
!/scripts/tools/build_worldmap_sea.py
!/scripts/tools/build_worldmap_lighttower.py
!/scripts/tools/convert_lab_furnace.py
!/scripts/tools/build_loki800.py
!/scripts/tools/author_loki_motions.py
!/scripts/tools/build_sundaegun_npc.py
!/scripts/tools/build_item_icons.py
!/scripts/tools/build_titles.py
!/scripts/tools/build_dex.py
!/scripts/tools/build_dragon_art_alias.py
!/scripts/tools/make_placeholder_uibar.py
!/scripts/tools/build_placeholder_icon.py
!/scripts/tools/run_all_tests.py
!/scripts/tools/strip_data_meta.py
!/scripts/tools/rebuild_assets.py
!/scripts/tools/build_text.py

# 검수·프로브 러너와 그 전용 씬 — 로컬 전용 (ShotHelper 오토로드만 예외)
/scripts/tools/shot_*.gd*
!/scripts/tools/shot_helper.gd
!/scripts/tools/shot_helper.gd.uid
/scripts/tools/probe_*.gd*
/scripts/tools/dev_*.gd*
/scenes/dev_*.tscn*
/scenes/shot_*.tscn*

# 원작 유래 표시 문자열(대사·설명문·이름) — 공개 배포본에 담지 않는다.
# 발행본 data/*.json 은 구조·수치·식별자만 갖고, 이 폴더가 있으면 런타임이 그쪽을 읽는다.
# 재생성: python scripts/tools/build_text.py (문자열 번들에서 복원되는 몫)
/data/text/

